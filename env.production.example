# 生产环境配置示例
# 用于 Docker Compose 部署（EC2 等服务器）

# ==========================================
# Docker 镜像配置
# ==========================================
DOCKER_IMAGE=your-dockerhub-username/crypto-bot:latest
# FRONTEND_IMAGE=your-dockerhub-username/crypto-frontend:latest  # 可选，有默认值

# ==========================================
# 币安交易所 API 配置
# ==========================================
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key
# 生产环境应设置为 false，测试使用 true
BINANCE_SANDBOX=false

# ==========================================
# 交易配置
# ==========================================
DEFAULT_SYMBOL=BTC/USDT
DEFAULT_TIMEFRAME=4h
MAX_POSITION_SIZE=0.1
DEFAULT_EXCHANGE=binance
BATCH_SIZE=1000
RATE_LIMIT_DELAY=0.1

# ==========================================
# 数据库配置（Docker 环境）
# ==========================================
# 注意：Docker Compose 中使用服务名而非 localhost
# DB_HOST 和 REDIS_HOST 由 docker-compose.prod.yml 自动设置
# 不要在这里设置 DB_HOST=postgres 或 REDIS_HOST=redis
# 仅设置数据库名、用户和密码
DB_NAME=crypto_trading
DB_USER=postgres
DB_PASSWORD=your_strong_password_here_at_least_16_chars

# ==========================================
# Redis 配置（Docker 环境）
# ==========================================
# Redis 密码（强烈建议设置）
REDIS_PASSWORD=your_redis_password_at_least_32_chars
REDIS_DB=0
REDIS_PREFIX=trading_bot:jobs:

# ==========================================
# 日志配置
# ==========================================
LOG_LEVEL=INFO
LOG_DIR=/app/logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=7

# ==========================================
# 重要提示
# ==========================================
# 1. 绝对不要在 .env 中设置 DB_HOST 和 REDIS_HOST
#    这些由 docker-compose.prod.yml 自动配置为容器服务名
# 2. 生产环境务必使用强密码
# 3. 生产环境设置 BINANCE_SANDBOX=false
# 4. 如果只获取 K 线数据，可以不配置 API 密钥

